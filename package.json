{
  "name": "coi-family",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cội — lịch ngày giỗ và kết nối dòng họ",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "backup": "node scripts/backup.js",
    "import": "node scripts/import.js",
    "test:pg": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@dqcai/vn-lunar": "1.0.1",
    "@fontsource/lora": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^7.0.6",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  }
}
