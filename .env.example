NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DATABASE_PATH=./data/coi.sqlite
# Ảnh chân dung nằm ngoài SQLite. Thư mục này phải được sao lưu cùng database.
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./backups
# Bản thử chỉ hoạt động khi NODE_ENV khác production.
DEMO_MODE=false
FAMILY_NAME=Dòng họ Đỗ
# Email này được quyền khởi tạo dòng họ sau khi xác minh OTP.
ADMIN_EMAIL=
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# preview: ghi email .eml vào data/mail, không gửi email ra ngoài.
# smtp: gửi thật qua nhà cung cấp SMTP của bạn.
MAIL_DRIVER=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cội <no-reply@example.com>
# Máy chủ phải chạy liên tục để gửi nhắc lịch.
REMINDERS_ENABLED=false
# Chỉ bật nếu chạy sau đúng 1 reverse proxy đáng tin cậy.
TRUST_PROXY=false
